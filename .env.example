# Beh3m0th — $0 Profile A. Copy to .env and fill any free-tier key you have.
# Google AI Studio also accepts GEMINI_API_KEY as an alias of GOOGLE_API_KEY.
# Empty FALLBACK_MODEL_* lines are skipped. Leave blank to use the defaults below.

GOOGLE_API_KEY=
# Low free-tier lite models, tried in order on 429/5xx.
GOOGLE_MODEL=gemini-3.1-flash-lite
GOOGLE_FALLBACK_MODEL_1=gemini-3.5-flash-lite
GOOGLE_FALLBACK_MODEL_2=gemini-2.5-flash-lite

GROQ_API_KEY=
# Free coding models: 20B base, then 27B. Leave fallback 2 blank to skip the 120B.
GROQ_MODEL=openai/gpt-oss-20b
GROQ_FALLBACK_MODEL_1=qwen/qwen3.8-27b
GROQ_FALLBACK_MODEL_2=

OPENROUTER_API_KEY=
# Free :free models only — small then mid-size.
OPENROUTER_MODEL=liquid/lfm-3-1.7b:free
OPENROUTER_FALLBACK_MODEL_1=google/gemma-4-26b-a4b-it:free
OPENROUTER_FALLBACK_MODEL_2=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free

PROFILE=embedded
LLM_CACHE_PATH=./data/llm_cache.db
LLM_MAX_RPM=12
SQLITE_PATH=./data/beh3m0th.db
QDRANT_LOCAL_PATH=./data/qdrant
